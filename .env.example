# Walmart Deal Finder env example
# Copy to .env

# Preferred: one line host:port:user:password
# ISP proxies alone are usually Akamai-blocked on Walmart — use a scraper API below.
PROXIES=

# auto = oxylabs → scraperapi → unlocker → uc → curl → playwright
WALMART_COLLECT_ENGINE=auto
WALMART_MAX_RETRIES=2
WALMART_REPORT_MAX_RETRIES=2
WALMART_TIMEOUT_SEC=35
WALMART_MAX_PER_QUERY=40
WALMART_QUERIES=clearance,rollback
WALMART_MIN_DELAY_SEC=3
WALMART_MAX_DELAY_SEC=8
WALMART_STOP_ON_CHALLENGE=0
WALMART_PROXY_ROTATE_SESSION=1

# --- Reliable live (recommended: set ONE) ---
# Oxylabs Walmart Search (store_id + delivery_zip): best store-scoped JSON
# https://oxylabs.io/products/scraper-api/ecommerce/walmarts
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# ScraperAPI Walmart (ultra_premium HTML / structured search)
# https://www.scraperapi.com/solutions/ecommerce-data-collection/walmart-scraper/
SCRAPERAPI_KEY=
SCRAPERAPI_ULTRA=1

# Bright Data Web Unlocker (not the ISP proxy zone)
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# Local Chrome — keep OFF for client (identical national lists across stores)
WALMART_UC_ENABLED=0
WALMART_ALLOW_BROWSER=0
WALMART_UC_HEADLESS=1

# Milestone 3 — deal thresholds (tunable)
DEAL_MIN_DISCOUNT_PCT=20
DEAL_HIDDEN_CLEARANCE_PCT=70
DEAL_CLEARANCE_PCT=40
DEAL_MARKDOWN_PCT=20
DEAL_INCLUDE_SHELF=0
DEAL_DEALS_ONLY=1
DEAL_MAX_DEALS=60
